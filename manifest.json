{
  "manifest_version": 3,
  "name": "Blur. The Image and Video blur extension",
  "version": "1.0.0",
  "description": "Auto-refresh DataAnnotation projects and click matching task titles.",
  "permissions": ["storage", "notifications", "offscreen"],
  "host_permissions": [
    "https://app.dataannotation.tech/*",
    "https://api.web3forms.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Blur. The Image and Video blur extension",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://app.dataannotation.tech/*"],
      "js": ["content.js"],
      "css": ["overlay.css"],
      "run_at": "document_end"
    }
  ]
}
